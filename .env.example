# Copiar a .env y ajustar valores antes de levantar el entorno.

# --- PostgreSQL ---
POSTGRES_USER=mapa_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mapa_curricular
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mapa_user:change_me@db:5432/mapa_curricular

# --- Seguridad / JWT ---
SECRET_KEY=change_me_to_a_long_random_value
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- Seed inicial ---
SEED_ADMIN_EMAIL=admin@universidad.edu
SEED_ADMIN_PASSWORD=ChangeMe123

# --- CORS (lista separada por comas) ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api

# --- Entorno (development | production) ---
ENVIRONMENT=development
UVICORN_WORKERS=2
